# קובץ דוגמה בלבד – אין להעלות ערכים אמיתיים ל-GitHub.
# ערכים ציבוריים לדפדפן נמצאים ב-web/config.js (כתובת + מפתח publishable בלבד).

# Secrets ל-Edge Functions (מוגדרים ב-Supabase: Project Settings → Edge Functions → Secrets)
# SUPABASE_URL ו-SUPABASE_SERVICE_ROLE_KEY מוגדרים אוטומטית על ידי Supabase – אין צורך להגדיר.
ALLOWED_ORIGINS=https://USERNAME.github.io
IP_HASH_SALT=random-long-string-here
BOOTSTRAP_TOKEN=one-time-random-string-at-least-20-chars

# לבדיקות מקומיות בלבד
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/shvilei_test
